style=\"font-family:'Playfair Display',serif;font-size:17px;font-weight:600\">Neglestell</span>\n              <span style=\"font-weight:700;color:var(--brun);white-space:nowrap;font-size:14px\">fr. 320 kr</span>\n            </div>\n            <p class=\"muted\" style=\"margin:6px 0 0;font-size:14px;line-height:1.5\">Manikyr med lakk, 30 min.</p>\n          </div>\n          <div class=\"card-soft\" style=\"padding:18px 20px\">\n            <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:12px\">\n              <span style=\"font-family:'Playfair Display',serif;font-size:17px;font-weight:600\">Gavekort</span>\n              <span style=\"font-weight:700;color:var(--brun);white-space:nowrap;font-size:14px\">valgfri sum</span>\n            </div>\n            <p class=\"muted\" style=\"margin:6px 0 0;font-size:14px;line-height:1.5\">Gi bort en opplevelse.</p>\n          </div>\n        </div>\n        <div style=\"display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-top:8px\">\n          <a class=\"btn btn-primary\" href=\"/bestill-kake/\">Bestill time</a>\n          <span class=\"muted\" style=\"font-size:15px\">eller ring 76 06 00 00</span>\n        </div>\n      </div>\n      <div style=\"width:100%;aspect-ratio:3/4;border-radius:18px;overflow:hidden\">\n        <img src=\"https://placehold.co/480x640/F2EADD/3B1A0E?text=Velværefoto\" alt=\"Velværeavdelingen\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n      </div>\n    </div>\n  </div>\n</section>\n<!-- /wp:html -->",
