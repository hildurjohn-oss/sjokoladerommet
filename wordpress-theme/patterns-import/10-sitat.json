  "title": "Sitat – Stort sentrert",
  "content": "<!-- wp:html -->\n<section class=\"section\" style=\"background:var(--krem-deep)\">\n  <div class=\"wrap\" style=\"max-width:680px;text-align:center\">\n    <svg width=\"36\" height=\"36\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" style=\"margin:0 auto\">\n      <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(0 50 50)\"/>\n      <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(72 50 50)\"/>\n      <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(144 50 50)\"/>\n      <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(216 50 50)\"/>\n      <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(288 50 50)\"/>\n      <circle cx=\"50\" cy=\"50\" r=\"8\" fill=\"var(--accent-deep)\"/>\n    </svg>\n    <blockquote style=\"margin:28px 0 20px;font-family:'Playfair Display',serif;font-style:italic;font-size:clamp(22px,3vw,34px);line-height:1.45;color:var(--brun)\">&ldquo;Sitatttekst her – noe personlig, varmt og minneverdig.&rdquo;</blockquote>\n    <cite style=\"font-style:normal;font-size:15px;letter-spacing:.06em;color:var(--brun-soft);text-transform:uppercase\">Janett Andersen, grunnlegger</cite>\n  </div>\n</section>\n<!-- /wp:html -->",
