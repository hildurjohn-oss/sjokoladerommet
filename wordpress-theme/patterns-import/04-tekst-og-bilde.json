  "__file": "wp_block",
  "title": "Tekst og bilde – Med sitat",
  "content": "<!-- wp:html -->\n<section class=\"section\">\n  <div class=\"wrap\">\n    <div class=\"cols-2\" style=\"align-items:center;gap:clamp(32px,5vw,72px)\">\n      <div style=\"width:100%;aspect-ratio:3/4;border-radius:18px;overflow:hidden\">\n        <img src=\"https://placehold.co/480x640/F2EADD/3B1A0E?text=Foto\" alt=\"Foto\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n      </div>\n      <div style=\"display:flex;flex-direction:column;gap:20px\">\n        <p class=\"eyebrow\">Vår historie</p>\n        <h2 style=\"font-size:clamp(26px,3.5vw,42px);margin:0\">Overskrift her</h2>\n        <p class=\"lead\">Innledende avsnitt som setter stemning. 2–3 setninger om historien eller saken.</p>\n        <p class=\"muted\" style=\"font-size:17px;line-height:1.75\">Brødtekst her. Beskriv bakgrunn, verdier eller en historie som engasjerer leseren.</p>\n        <blockquote style=\"margin:0;border-left:3px solid var(--accent-deep);padding-left:20px;font-family:'Playfair Display',serif;font-style:italic;font-size:19px;line-height:1.55;color:var(--brun)\">&ldquo;Sitatttekst her – noe personlig og minneverdig.&rdquo;</blockquote>\n        <div style=\"margin-top:4px\">\n          <a class=\"btn btn-primary\" href=\"/om-oss/\">Les mer om oss</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n<!-- /wp:html -->",
  "syncStatus": ""
}
