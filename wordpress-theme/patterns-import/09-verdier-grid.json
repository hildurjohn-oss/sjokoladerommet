{
  "__file": "wp_block",
  "title": "Verdier – Fire-kolonne kortgrid",
  "content": "<!-- wp:html -->\n<section class=\"section\" style=\"background:var(--krem-deep)\">\n  <div class=\"wrap\">\n    <div style=\"text-align:center;margin-bottom:48px\">\n      <p class=\"eyebrow\" style=\"justify-content:center\">Det vi tror på</p>\n      <h2 style=\"font-size:clamp(28px,3.5vw,44px);margin:16px 0 0\">Våre verdier</h2>\n    </div>\n    <div class=\"cols-4\">\n      <div class=\"card-soft\" style=\"text-align:center;padding:32px 24px\">\n        <svg width=\"36\" height=\"36\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" style=\"margin:0 auto 16px\">\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(0 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(72 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(144 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(216 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(288 50 50)\"/>\n          <circle cx=\"50\" cy=\"50\" r=\"8\" fill=\"var(--accent-deep)\"/>\n        </svg>\n        <h3 style=\"margin:0 0 10px;font-size:19px\">Kvalitet</h3>\n        <p class=\"muted\" style=\"margin:0;font-size:15px;line-height:1.65\">Vi bruker kun de beste råvarene og tar oss tid til å gjøre det ordentlig.</p>\n      </div>\n      <div class=\"card-soft\" style=\"text-align:center;padding:32px 24px\">\n        <svg width=\"36\" height=\"36\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" style=\"margin:0 auto 16px\">\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(0 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(72 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(144 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(216 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(288 50 50)\"/>\n          <circle cx=\"50\" cy=\"50\" r=\"8\" fill=\"var(--accent-deep)\"/>\n        </svg>\n        <h3 style=\"margin:0 0 10px;font-size:19px\">Håndverk</h3>\n        <p class=\"muted\" style=\"margin:0;font-size:15px;line-height:1.65\">Hvert produkt lages for hånd med kjærlighet og oppmerksomhet til detaljer.</p>\n      </div>\n      <div class=\"card-soft\" style=\"text-align:center;padding:32px 24px\">\n        <svg width=\"36\" height=\"36\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" style=\"margin:0 auto 16px\">\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(0 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(72 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(144 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(216 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(288 50 50)\"/>\n          <circle cx=\"50\" cy=\"50\" r=\"8\" fill=\"var(--accent-deep)\"/>\n        </svg>\n        <h3 style=\"margin:0 0 10px;font-size:19px\">Bærekraft</h3>\n        <p class=\"muted\" style=\"margin:0;font-size:15px;line-height:1.65\">Vi velger lokale og etiske råvarer der det er mulig, og minimerer svinn.</p>\n      </div>\n      <div class=\"card-soft\" style=\"text-align:center;padding:32px 24px\">\n        <svg width=\"36\" height=\"36\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" style=\"margin:0 auto 16px\">\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(0 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(72 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(144 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(216 50 50)\"/>\n          <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(288 50 50)\"/>\n          <circle cx=\"50\" cy=\"50\" r=\"8\" fill=\"var(--accent-deep)\"/>\n        </svg>\n        <h3 style=\"margin:0 0 10px;font-size:19px\">Varme</h3>\n        <p class=\"muted\" style=\"margin:0;font-size:15px;line-height:1.65\">Alle er velkomne. Vi ønsker at du skal føle deg hjemme hos oss.</p>\n      </div>\n    </div>\n  </div>\n</section>\n<!-- /wp:html -->",
  "syncStatus": ""
}
