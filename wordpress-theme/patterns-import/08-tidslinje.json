{
  "__file": "wp_block",
  "title": "Tidslinje – Historisk oversikt",
  "content": "<!-- wp:html -->\n<section class=\"section\">\n  <div class=\"wrap\" style=\"max-width:820px\">\n    <p class=\"eyebrow\">Vår reise</p>\n    <h2 style=\"font-size:clamp(28px,3.5vw,44px);margin:16px 0 40px\">Vår historie</h2>\n    <ul style=\"list-style:none;padding:0;margin:0;border-left:2px solid var(--accent-soft)\">\n      <li style=\"display:grid;grid-template-columns:68px 1fr;gap:28px;padding:22px 0;position:relative\">\n        <div style=\"text-align:right;padding-right:20px;font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:var(--accent-deep);line-height:1.3\">1998</div>\n        <div style=\"position:relative\">\n          <span style=\"position:absolute;left:-37px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--accent-deep);border:2px solid var(--krem);display:block\"></span>\n          <h3 style=\"margin:0 0 8px;font-size:20px\">Sjokoladerommet åpner</h3>\n          <p class=\"muted\" style=\"margin:0;font-size:16px;line-height:1.65\">Janett Andersen åpner et lite sjokolatelier i Svolvær sentrum med drømmen om å lage sjokolade av de beste råvarene.</p>\n        </div>\n      </li>\n      <li style=\"display:grid;grid-template-columns:68px 1fr;gap:28px;padding:22px 0;position:relative\">\n        <div style=\"text-align:right;padding-right:20px;font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:var(--accent-deep);line-height:1.3\">2003</div>\n        <div style=\"position:relative\">\n          <span style=\"position:absolute;left:-37px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--accent-deep);border:2px solid var(--krem);display:block\"></span>\n          <h3 style=\"margin:0 0 8px;font-size:20px\">Kafé og velværeavdeling</h3>\n          <p class=\"muted\" style=\"margin:0;font-size:16px;line-height:1.65\">Vi utvider med en liten kafé og begynner med velværebehandlinger som ansiktsbehandling og massasje.</p>\n        </div>\n      </li>\n      <li style=\"display:grid;grid-template-columns:68px 1fr;gap:28px;padding:22px 0;position:relative\">\n        <div style=\"text-align:right;padding-right:20px;font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:var(--accent-deep);line-height:1.3\">2014</div>\n        <div style=\"position:relative\">\n          <span style=\"position:absolute;left:-37px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--accent-deep);border:2px solid var(--krem);display:block\"></span>\n          <h3 style=\"margin:0 0 8px;font-size:20px\">Milepæl her</h3>\n          <p class=\"muted\" style=\"margin:0;font-size:16px;line-height:1.65\">Beskriv hva som skjedde dette året.</p>\n        </div>\n      </li>\n      <li style=\"display:grid;grid-template-columns:68px 1fr;gap:28px;padding:22px 0;position:relative\">\n        <div style=\"text-align:right;padding-right:20px;font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:var(--accent-deep);line-height:1.3\">2024</div>\n        <div style=\"position:relative\">\n          <span style=\"position:absolute;left:-37px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--accent-deep);border:2px solid var(--krem);display:block\"></span>\n          <h3 style=\"margin:0 0 8px;font-size:20px\">I dag</h3>\n          <p class=\"muted\" style=\"margin:0;font-size:16px;line-height:1.65\">Beskriv dagens situasjon og fremtidsplaner.</p>\n        </div>\n      </li>\n    </ul>\n  </div>\n</section>\n<!-- /wp:html -->",
  "syncStatus": ""
}
