{
  "__file": "wp_block",
  "title": "Menyliste – Kategori med priser",
  "content": "<!-- wp:html -->\n<section class=\"section\">\n  <div class=\"wrap\" style=\"max-width:820px\">\n    <div style=\"display:flex;align-items:baseline;gap:14px;margin-bottom:32px;padding-bottom:14px;border-bottom:1.5px solid var(--brun)\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" style=\"flex-shrink:0\">\n        <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(0 50 50)\"/>\n        <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(72 50 50)\"/>\n        <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(144 50 50)\"/>\n        <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(216 50 50)\"/>\n        <ellipse cx=\"50\" cy=\"28\" rx=\"10\" ry=\"20\" fill=\"var(--accent-deep)\" transform=\"rotate(288 50 50)\"/>\n        <circle cx=\"50\" cy=\"50\" r=\"8\" fill=\"var(--accent-deep)\"/>\n      </svg>\n      <h2 style=\"font-size:clamp(24px,3vw,36px);margin:0\">Konfekt &amp; sjokolade</h2>\n    </div>\n    <ul style=\"list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:18px\">\n      <li style=\"display:grid;grid-template-columns:1fr auto;gap:16px;align-items:baseline\">\n        <div>\n          <div style=\"display:flex;align-items:baseline;gap:10px;flex-wrap:wrap\">\n            <span style=\"font-family:'Playfair Display',serif;font-weight:600;font-size:21px\">Signatur pralinér</span>\n            <span class=\"chip accent\" style=\"padding:2px 10px;font-size:11px;letter-spacing:.1em;text-transform:uppercase\">Signatur</span>\n          </div>\n          <div class=\"muted\" style=\"font-size:15px;margin-top:4px\">Håndlaget av Janett, mørk sjokolade med lavendel og havsalt.</div>\n        </div>\n        <div style=\"font-family:Nunito,sans-serif;font-weight:700;color:var(--brun);font-variant-numeric:tabular-nums;white-space:nowrap;font-size:15px\">48 kr/stk</div>\n      </li>\n      <li style=\"display:grid;grid-template-columns:1fr auto;gap:16px;align-items:baseline\">\n        <div>\n          <div style=\"font-family:'Playfair Display',serif;font-weight:600;font-size:21px\">Trøfler</div>\n          <div class=\"muted\" style=\"font-size:15px;margin-top:4px\">Klassiske sjokoladetrøfler rullet i kakaopulver.</div>\n        </div>\n        <div style=\"font-family:Nunito,sans-serif;font-weight:700;color:var(--brun);font-variant-numeric:tabular-nums;white-space:nowrap;font-size:15px\">32 kr/stk</div>\n      </li>\n      <li style=\"display:grid;grid-template-columns:1fr auto;gap:16px;align-items:baseline\">\n        <div>\n          <div style=\"font-family:'Playfair Display',serif;font-weight:600;font-size:21px\">Sjokoladeboks</div>\n          <div class=\"muted\" style=\"font-size:15px;margin-top:4px\">Utvalg av 12 pralinér i gaveeske.</div>\n        </div>\n        <div style=\"font-family:Nunito,sans-serif;font-weight:700;color:var(--brun);font-variant-numeric:tabular-nums;white-space:nowrap;font-size:15px\">420 kr</div>\n      </li>\n      <li style=\"display:grid;grid-template-columns:1fr auto;gap:16px;align-items:baseline\">\n        <div>\n          <div style=\"font-family:'Playfair Display',serif;font-weight:600;font-size:21px\">Produktnavn</div>\n          <div class=\"muted\" style=\"font-size:15px;margin-top:4px\">Beskrivelse av produktet her.</div>\n        </div>\n        <div style=\"font-family:Nunito,sans-serif;font-weight:700;color:var(--brun);font-variant-numeric:tabular-nums;white-space:nowrap;font-size:15px\">Pris kr</div>\n      </li>\n    </ul>\n  </div>\n</section>\n<!-- /wp:html -->",
  "syncStatus": ""
}
