{
  "version": "2.0",
  "theme": "sjokoladerommet",
  "type": "acf-blocks",
  "description": "ACF Custom Blocks for Sjokoladerommet. Access via: Add Block → Sjokoladerommet category.",
  "blocks": [
    {
      "name": "acf/hero-section",
      "title": "Hero – Seksjon",
      "file": "blocks/hero-section/render.php",
      "description": "Page hero. Supports two modes: 'simple' (centered header with eyebrow + H1 + lead) and 'fullbleed' (diagonal-stripe card with portrait photo, buttons, and chips).",
      "fields": [
        { "name": "style",     "type": "select",   "options": ["simple", "fullbleed"], "description": "Layout mode" },
        { "name": "eyebrow",   "type": "text",     "description": "Small uppercase label above title" },
        { "name": "title",     "type": "text",     "description": "Main H1 heading" },
        { "name": "lead",      "type": "textarea", "description": "2-3 sentence intro" },
        { "name": "image",     "type": "image",    "description": "Portrait photo (fullbleed mode only, 4:5 ratio)" },
        { "name": "btn1_label","type": "text",     "description": "Primary button text (fullbleed only)" },
        { "name": "btn1_url",  "type": "url",      "description": "Primary button link" },
        { "name": "btn2_label","type": "text",     "description": "Secondary button text" },
        { "name": "btn2_url",  "type": "url",      "description": "Secondary button link" },
        { "name": "chips",     "type": "repeater", "description": "Info chips (opening hours, address)", "sub_fields": [
          { "name": "text",  "type": "text",   "description": "Chip label" },
          { "name": "style", "type": "select", "options": ["default", "fjord"], "description": "Chip color" }
        ]}
      ]
    },
    {
      "name": "acf/text-section",
      "title": "Tekstseksjon",
      "file": "blocks/text-section/render.php",
      "description": "Generic text section with optional eyebrow, H2, lead, and body text. Supports centered or left alignment and rose/fjord accent colors.",
      "fields": [
        { "name": "eyebrow", "type": "text",     "description": "Small uppercase label" },
        { "name": "title",   "type": "text",     "description": "H2 heading" },
        { "name": "lead",    "type": "textarea", "description": "Lead paragraph" },
        { "name": "body",    "type": "textarea", "description": "Body paragraph" },
        { "name": "accent",  "type": "select",   "options": ["rose", "fjord"], "description": "Eyebrow accent color" },
        { "name": "align",   "type": "select",   "options": ["left", "center"], "description": "Text alignment" }
      ]
    },
    {
      "name": "acf/menu-list",
      "title": "Menyliste",
      "file": "blocks/menu-list/render.php",
      "description": "One menu category with a FlowerMark-decorated title and a list of items (name, description, price). Insert multiple times for multiple categories.",
      "fields": [
        { "name": "eyebrow", "type": "text",   "description": "Small label above title" },
        { "name": "title",   "type": "text",   "description": "Category name (H2)" },
        { "name": "accent",  "type": "select", "options": ["rose", "fjord"], "description": "FlowerMark color" },
        { "name": "items",   "type": "repeater", "description": "Menu items", "sub_fields": [
          { "name": "name",        "type": "text",     "description": "Item name" },
          { "name": "description", "type": "textarea", "description": "Item description" },
          { "name": "price",       "type": "text",     "description": "Price (e.g. 32 kr/stk)" },
          { "name": "signature",   "type": "true_false", "description": "Show 'Signatur' badge" }
        ]}
      ]
    },
    {
      "name": "acf/timeline",
      "title": "Tidslinje",
      "file": "blocks/timeline/render.php",
      "description": "Vertical timeline for milestones/history. Each step has year, title, and description.",
      "fields": [
        { "name": "eyebrow", "type": "text",     "description": "Small label above heading" },
        { "name": "title",   "type": "text",     "description": "Section H2 heading" },
        { "name": "items",   "type": "repeater", "description": "Timeline steps", "sub_fields": [
          { "name": "year",        "type": "text",     "description": "Year or date label" },
          { "name": "step_title",  "type": "text",     "description": "Milestone title (H3)" },
          { "name": "description", "type": "textarea", "description": "What happened" }
        ]}
      ]
    },
    {
      "name": "acf/card-grid",
      "title": "Kortgrid",
      "file": "blocks/card-grid/render.php",
      "description": "Responsive grid of image cards. Supports 3 or 4 columns, white or cream background. Each card has an optional ribbon badge.",
      "fields": [
        { "name": "eyebrow", "type": "text",   "description": "Small label above section heading" },
        { "name": "title",   "type": "text",   "description": "Section H2 heading" },
        { "name": "cols",    "type": "select", "options": ["3", "4"], "description": "Number of columns" },
        { "name": "bg",      "type": "select", "options": ["white", "cream"], "description": "Section background" },
        { "name": "cards",   "type": "repeater", "description": "Cards", "sub_fields": [
          { "name": "image",      "type": "image",     "description": "Card image (4:3 ratio)" },
          { "name": "ribbon",     "type": "text",      "description": "Optional ribbon badge label" },
          { "name": "card_title", "type": "text",      "description": "Card heading (H3)" },
          { "name": "description","type": "textarea",  "description": "Card body text" }
        ]}
      ]
    },
    {
      "name": "acf/quote",
      "title": "Sitat",
      "file": "blocks/quote/render.php",
      "description": "Large centered quote with FlowerMark decoration and citation. Good as closing section.",
      "fields": [
        { "name": "quote",    "type": "textarea", "description": "Quote text (without quotation marks)" },
        { "name": "citation", "type": "text",     "description": "Attribution (author/source)" },
        { "name": "accent",   "type": "select",   "options": ["rose", "fjord"], "description": "FlowerMark color" },
        { "name": "bg",       "type": "select",   "options": ["white", "cream"], "description": "Section background" }
      ]
    },
    {
      "name": "acf/cta",
      "title": "CTA – Mørk bakgrunn",
      "file": "blocks/cta/render.php",
      "description": "Dark brown call-to-action with large decorative FlowerMark, heading, body text, and two buttons. Typically placed at the bottom of pages.",
      "fields": [
        { "name": "title",      "type": "text",     "description": "CTA headline (white on dark bg)" },
        { "name": "body",       "type": "textarea", "description": "Supporting text" },
        { "name": "btn1_label", "type": "text",     "description": "Primary button text" },
        { "name": "btn1_url",   "type": "url",      "description": "Primary button link" },
        { "name": "btn2_label", "type": "text",     "description": "Secondary button text" },
        { "name": "btn2_url",   "type": "url",      "description": "Secondary button link" },
        { "name": "address",    "type": "text",     "description": "Address line shown below buttons" }
      ]
    },
    {
      "name": "acf/two-column",
      "title": "To kolonner – Bilde og tekst",
      "file": "blocks/two-column/render.php",
      "description": "Two-column layout with image on one side and content on the other. Two modes: 'text' (eyebrow, heading, lead, body, optional quote, button) or 'services' (services grid with prices and contact button).",
      "fields": [
        { "name": "text_mode",  "type": "select", "options": ["text", "services"], "description": "Content mode" },
        { "name": "eyebrow",    "type": "text",     "description": "Small label above heading" },
        { "name": "title",      "type": "text",     "description": "H2 heading" },
        { "name": "lead",       "type": "textarea", "description": "Lead paragraph" },
        { "name": "body",       "type": "textarea", "description": "Body paragraph (text mode)" },
        { "name": "quote_text", "type": "textarea", "description": "Styled blockquote (text mode)" },
        { "name": "btn_label",  "type": "text",     "description": "Button label (text mode)" },
        { "name": "btn_url",    "type": "url",      "description": "Button link (text mode)" },
        { "name": "image",      "type": "image",    "description": "Photo (3:4 ratio)" },
        { "name": "image_side", "type": "select",   "options": ["left", "right"], "description": "Which side the image appears on" },
        { "name": "accent",     "type": "select",   "options": ["rose", "fjord"], "description": "Accent color for eyebrow/quote border" },
        { "name": "bg",         "type": "select",   "options": ["white", "cream"], "description": "Section background" },
        { "name": "services",   "type": "repeater", "description": "Services (services mode only)", "sub_fields": [
          { "name": "service_name",  "type": "text",     "description": "Service name" },
          { "name": "service_desc",  "type": "textarea", "description": "Short description" },
          { "name": "service_price", "type": "text",     "description": "Price" }
        ]},
        { "name": "contact_btn_label", "type": "text", "description": "Contact/booking button label (services mode)" },
        { "name": "contact_btn_url",   "type": "url",  "description": "Contact/booking button link" },
        { "name": "contact_extra",     "type": "text", "description": "Extra info beside button (e.g. phone number)" }
      ]
    }
  ]
}
